# Server-only. Never prefix these with NEXT_PUBLIC_.
PNTICKET_API_URL=https://api.dienmaykimbien.com.vn
# Canonical dashboard origin. Use https://your-admin-domain in deployment.
APP_ORIGIN=http://localhost:3002

# Enable trip writes only for the selected operator UUID. Empty disables writes.
PNTICKET_TRIP_WRITE_OPERATOR_ID=

# Only enable when the trusted ingress overwrites this header with one verified IP.
# Set the same server-only key (32+ characters) on Dashboard and API.
# PNTICKET_TRUSTED_CLIENT_IP_HEADER=
# PNTICKET_LOGIN_PROXY_KEY=
